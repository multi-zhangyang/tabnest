{
  "name": "tabnest",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/clean-dist.mjs && tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "test": "node --test tools/*.test.mjs",
    "test:browser": "node tools/browser-check.mjs",
    "test:extension": "node tools/extension-check.mjs",
    "test:scroll": "node tools/scroll-check.mjs",
    "test:ui-details": "node tools/ui-detail-check.mjs",
    "check": "npm run lint && npm test && npm run build && npm run test:browser && npm run test:extension && npm run test:scroll && npm run test:ui-details && npm run test:product && npm run test:performance",
    "release": "npm run check && node tools/release.mjs",
    "test:product": "node tools/product-check.mjs",
    "test:performance": "node tools/performance-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.13.0",
    "@eslint/js": "^10",
    "@types/chrome": "^0.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fflate": "0.8.3",
    "globals": "^17",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer-core": "^25.12.0",
    "simple-icons": "^16.33.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
